-- Tween function
local function tweenTo(targetPos)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end
    
    local tween = TweenService:Create(hrp, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        CFrame = targetPos
    })
    tween:Play()
    tween.Completed:Wait()
    
    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
    end
end

-- Get enemies
local function getEnemies(position, radius)
    radius = radius or 120
    local enemies = {}
    local seen = {}
    
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v ~= LocalPlayer.Character then
            local hrp = v:FindFirstChild("HumanoidRootPart")
            if hrp then
                local humanoid = v:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local dist = (position - hrp.Position).Magnitude
                    if dist <= radius then
                        local isNPC = v:FindFirstChild("NPC") or v:FindFirstChild("QuestGiver")
                        if not isNPC then
                            table.insert(enemies, {
                                Model = v,
                                Humanoid = humanoid,
                                RootPart = hrp,
                                Distance = dist,
                                Name = v.Name,
                            })
                            seen[v] = true
                        end
                    end
                end
            end
        end
    end
    
    table.sort(enemies, function(a, b) return a.Distance < b.Distance end)
    return enemies
end

